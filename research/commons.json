ns.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/c/c9/Mina_de_Chuquicamata%2C_Calama%2C_Chile%2C_2016-02-01%2C_DD_121.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Mina_de_Chuquicamata,_Calama,_Chile,_2016-02-01,_DD_121.JPG","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=47636979","extmetadata":{"DateTime":{"value":"2016-03-20 16:27:09","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Mina de Chuquicamata, Calama, Chile, 2016-02-01, DD 121","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with Canon EOS 5DS R|Chuquicamata Mine|Featured pictures of Chile|Featured pictures by User:Poco a poco|Images by User:Poco a poco|Featured pictures of Chile by User:Poco a poco|Images of Chile by User:Poco a poco|Featured pictures on Commons by User:Poco a poco|Featured pictures of others by User:Poco a poco|Chile photographs taken on 2016-02-01|Images by User:Poco a poco taken in 2016","source":"commons-categories","hidden":""},"Assessments":{"value":"quality|featured|potd","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Interior view of <a href=\"https://en.wikipedia.org/wiki/Chuquicamata\" class=\"extiw\" title=\"en:Chuquicamata\">Chuquicamata</a>, a state-owned <a href=\"https://en.wikipedia.org/wiki/copper\" class=\"extiw\" title=\"en:copper\">copper</a> <a href=\"https://en.wikipedia.org/wiki/Mining\" class=\"extiw\" title=\"en:Mining\">mine</a> located 2,850 metres (9,350\u00a0ft) above sea level just outside <a href=\"https://en.wikipedia.org/wiki/Calama,_Chile\" class=\"extiw\" title=\"en:Calama, Chile\">Calama</a>, north of <a href=\"//commons.wikimedia.org/wiki/Chile\" title=\"Chile\">Chile</a>. It is by excavated volume the largest <a href=\"https://en.wikipedia.org/wiki/open-pit_mining\" class=\"extiw\" title=\"en:open-pit mining\">open pit</a> copper mine in the world. The huge hole was started in 1882 as a mine to extract gold and copper. It is 3.5 kilometres (2.2\u00a0mi) long, 4.5 kilometres (2.8\u00a0mi) wide and with a depth of 850 metres (2,790\u00a0ft) it is the second deepest open-pit mine in the world (after <a href=\"https://en.wikipedia.org/wiki/Bingham_Canyon_Mine\" class=\"extiw\" title=\"en:Bingham Canyon Mine\">Bingham Canyon Mine</a> in Utah, USA).","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2016-02-01 19:46:31","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q28147777\" class=\"extiw\" title=\"d:Q28147777\"><span title=\"Spanish photographer\">Diego Delso</span></a></bdi>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Diego Delso","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-4.0","source":"commons-templates","hidden":""}}}]},"47636985":{"pageid":47636985,"ns":6,"title":"File:Mina de Chuquicamata, Calama, Chile, 2016-02-01, DD 125.JPG","index":7,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/27/Mina_de_Chuquicamata%2C_Calama%2C_Chile%2C_2016-02-01%2C_DD_125.JPG/1920px-Mina_de_Chuquicamata%2C_Calama%2C_Chile%2C_2016-02-01%2C_DD_125.JPG?utm_source=com